[node name="ActionHBox" type="HBoxContainer" parent="UI/ToolConfirmModal/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BtnAuthorizeTool" type="Button" parent="UI/ToolConfirmModal/Margin/VBox/ActionHBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = SubResource("SystemFont_pill")
theme_override_font_sizes/font_size = 11
theme_override_styles/normal = SubResource("StyleBoxFlat_card_btn")
text = "✓ Authorize & Run"

[node name="BtnDenyTool" type="Button" parent="UI/ToolConfirmModal/Margin/VBox/ActionHBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.85, 0.25, 0.25, 1)
theme_override_fonts/font = SubResource("SystemFont_pill")
theme_override_font_sizes/font_size = 11
text = "✕ Deny & Cancel"
